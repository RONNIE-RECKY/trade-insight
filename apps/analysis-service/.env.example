# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Everything here is OPTIONAL: the app runs without any of it, using Yahoo
# for prices and fixture headlines for news. These upgrade data quality.

# --- Market data ---------------------------------------------------------
# Real-time candles + spot XAU/USD, replacing Yahoo's ~15-minute delay.
# Free key: https://twelvedata.com (800 req/day, 8/min — the app falls back
# to Yahoo automatically when throttled).
TWELVE_DATA_API_KEY=

# --- News ----------------------------------------------------------------
# Real market headlines and the economic calendar (exact NFP/CPI/FOMC times
# plus actual/estimate figures) instead of the built-in demo headlines.
# Free key: https://finnhub.io
FINNHUB_API_KEY=

# --- Email (signup verification, trade confirmations) --------------------
# Resend is the reliable option — HTTPS, not blocked by hosts that block SMTP.
# Free key: https://resend.com (3,000 emails/month)
RESEND_API_KEY=
RESEND_FROM=PIP HIVE <onboarding@resend.dev>

# --- Local app config ----------------------------------------------------
WEB_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Seeded admin account (defaults to admin@tradeinsight.app / Admin1234!)
ADMIN_EMAIL=
ADMIN_PASSWORD=
